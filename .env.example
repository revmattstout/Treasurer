# Copy this file to ".env" (same folder) and fill it in. ".env" is git-ignored,
# so passwords in it never end up in the repository.

# Password to open the app (strongly recommended if anyone else can reach it)
APP_PASSWORD=

# Claude integration: reads receipts and PDF statements, suggests categories, drafts summaries
ANTHROPIC_API_KEY=

# --- Email import ---
TREASURER_EMAIL_ADDRESS=vsuwesleyfinance@gmail.com
# A Gmail APP PASSWORD (16 letters), NOT the account's normal password.
# Google Account -> Security -> 2-Step Verification (turn on) -> App passwords
TREASURER_EMAIL_APP_PASSWORD=
# Who may email files in. Mail from anyone else is ignored.
TREASURER_EMAIL_ALLOWED_SENDERS=you@example.com
# Check the inbox automatically every N minutes while the app is running (optional)
TREASURER_EMAIL_POLL_MINUTES=10
